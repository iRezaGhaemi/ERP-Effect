  },
  "dependencies": {
    "@effect/audit": "workspace:*",
    "@effect-erp/contracts": "workspace:*",
    "@effect/users": "workspace:*",
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "typeorm": "^0.3.28",
    "zod": "^4.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@effect/ui": "workspace:*"
  },
  "devDependencies": {
    "@effect-erp/testing": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^24.1.3"
  }
